# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → App settings → Secrets.
GEMINI_API_KEY = "your-gemini-api-key"

# Optional, for public deployments: a free-tier key from a SEPARATE Google project with
# NO billing. Keyless visitors share it for catalogue curation only; it is never used
# for image rendering.
GEMINI_DEMO_KEY = "your-free-tier-demo-key"
